# Copy to `.env` on the host and fill in real values. `.env` is git-ignored and
# must stay that way — it holds the CalDAV app-specific password. Nothing secret
# is baked into the image; credentials are injected at runtime.

# --- Image / deploy (read by docker-compose.yml) ---
IMAGE=ghcr.io/jb09/caldav-mcp-wrapper:latest
CONTAINER_NAME=caldav-mcp
# External Docker network shared with your authorization proxy (e.g. Pomerium).
PROXY_NETWORK=pomerium

# --- CalDAV server (defaults target Apple iCloud) ---
CALDAV_URL=https://caldav.icloud.com/
# For iCloud this is your Apple ID (full email address).
CALDAV_USERNAME=you@example.com
# iCloud App-Specific Password (Apple ID -> Sign-In and Security -> App-Specific
# Passwords). This is NOT your normal Apple ID password.
CALDAV_PASSWORD=your-app-specific-password

# --- Calendar selection ---
# Default calendar (by display name) used when a tool call omits `calendar`.
DEFAULT_CALENDAR=Home
# Comma-separated allowlist of calendar display names. Tools may only read from /
# write to these, so even a misused tool cannot touch other calendars. Leave
# empty to allow every calendar in the account.
ALLOWED_CALENDARS=Home

# --- Read-only mode ---
# Set to `true` to disable the create/update/delete tools (list/get still work).
# Also disables add_subscription/remove_subscription, since those write to the
# persisted pull list.
READ_ONLY=false

# --- Subscribed ICS feeds (read-only) ---
# Apple "subscribed calendars" (team schedules, holiday feeds) are stored
# device-side and are NOT reachable over CalDAV, so they never appear in
# list_calendars. Subscribe to their underlying ICS URL here instead and the
# server serves their events alongside the real calendars — always read-only.
#
# Where the pull list is persisted. Must be on a mounted volume (docker-compose
# mounts the `caldav_mcp_data` volume at /data) so feeds added at runtime with the
# add_subscription tool survive a container restart.
SUBSCRIPTIONS_FILE=/data/subscriptions.json
# Optional seed merged into the pull list on startup: a JSON object of name -> URL.
# Feeds added later via add_subscription are kept alongside these.
# SUBSCRIBED_ICS={"Team Schedule":"https://example.com/team.ics"}
# Comma-separated allowlist of subscription names/ids. Leave empty to allow all.
# Separate from ALLOWED_CALENDARS because subscriptions are never writable.
ALLOWED_SUBSCRIPTIONS=
# Per-request timeout (seconds) for fetching a feed. Same reasoning as
# CALDAV_TIMEOUT — keep it below the proxy's gateway timeout.
ICS_TIMEOUT=20
# How long a fetched feed is reused before revalidating (ETag / If-Modified-Since).
ICS_CACHE_TTL=900
# add_subscription fetches whatever URL it is given, so private/loopback/link-local
# targets are refused by default to keep it from probing the internal network.
# Only set `true` if you need to subscribe to a feed hosted on your own LAN.
ICS_ALLOW_PRIVATE_IPS=false

# --- Event query behavior ---
# Per-request network timeout (seconds) for CalDAV calls. Keep it well below the
# fronting proxy's gateway timeout so a slow iCloud query returns a clean tool
# error instead of the proxy killing the connection and surfacing a 502.
CALDAV_TIMEOUT=20
# Expand recurring events server-side so each occurrence lands on its real date
# within the queried window. iCloud's expand support is uneven; list_events
# automatically retries without expansion if it errors. Set `false` to skip expand.
EXPAND_RECURRENCES=true

# --- Logging ---
# The container healthcheck polls /healthz every 30s; those access-log lines are
# filtered out by default so real activity stays visible in `docker compose logs`.
# Set `true` when debugging the healthcheck itself.
LOG_HEALTHZ=false

# --- Startup self-test ---
# Set to `true` to connect to CalDAV and list calendars when the server starts,
# verifying the configuration. On failure the reason is logged (auth / connection
# / discovery) and the server keeps running.
STARTUP_TEST=false

# --- App-layer auth (defense in depth) ---
# The external authorization proxy is ALWAYS required. Set this to `true` to ALSO
# cryptographically verify Pomerium's identity assertion on every /mcp request
# (signature + expiry + audience). This blocks anything on the shared Docker
# network from reaching the app directly, bypassing Pomerium.
#
# When true you MUST:
#   1. Set `pass_identity_headers: true` on the Pomerium route (see README) — else
#      Pomerium sends no header and every request is rejected.
#   2. Set POMERIUM_JWKS_URL and POMERIUM_AUDIENCE below.
REQUIRE_POMERIUM_IDENTITY=false
# Pomerium's JWKS endpoint (public keys for its signing key). Required when the
# gate is on; the server refuses to start without it.
# POMERIUM_JWKS_URL=https://caldav-mcp.example.com/.well-known/pomerium/jwks.json
# Expected `aud` claim — the route's host/URL. Verified when set (strongly recommended).
# POMERIUM_AUDIENCE=caldav-mcp.example.com
# Expected `iss` claim. Verified only when set.
# POMERIUM_ISSUER=
# Header(s) carrying the assertion JWT (comma-separated). Default covers MCP mode
# (x-pomerium-assertion) and the general header (x-pomerium-jwt-assertion).
# POMERIUM_IDENTITY_HEADER=x-pomerium-assertion,x-pomerium-jwt-assertion

# --- Server bind (rarely changed) ---
# HOST=0.0.0.0
# PORT=8080

# --- Host header allowlist (DNS-rebinding guard) ---
# The MCP SDK can reject requests whose `Host` header is not on this list,
# answering 421. Behind Pomerium the header is the public route host, not the
# container address, so set this to that hostname to keep the guard on:
# MCP_ALLOWED_HOSTS=caldav-mcp.example.com
# Use `host:port` to pin a port, or `host:*` for any. Comma-separated for several.
#
# Left empty (the default) the guard is OFF and any Host header is accepted —
# the fronting proxy is then the only thing checking it, which is the same
# posture as before the SDK 2.x upgrade. A warning is logged at startup.
#
# Matching `Origin` allowlist for browser-based clients. Defaults to https:// +
# each MCP_ALLOWED_HOSTS entry, so it only needs setting for plain-HTTP origins.
# MCP_ALLOWED_ORIGINS=https://caldav-mcp.example.com

# --- Tool catalog caching ---
# How long clients may reuse a `tools/list` result (MCP 2026-07-28 hint). The
# catalog is fixed at import time, so an hour is safe; 0 makes clients re-fetch.
# TOOLS_LIST_TTL_MS=3600000
